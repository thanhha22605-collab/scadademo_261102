# Nguồn dữ liệu cho web app SCADA.
# - sim: chạy bộ mô phỏng trong bộ nhớ (mặc định).
# - plc: đọc tín hiệu thật từ gateway Omron FINS (xem thư mục gateway/).
# Sao chép file này thành .env rồi chỉnh:
#   cp .env.example .env

VITE_DATA_SOURCE=sim
# Địa chỉ WebSocket của gateway (IP máy chạy gateway trong mạng OT):
VITE_GATEWAY_WS=ws://localhost:8081
# API cấu hình dùng cùng gateway; có thể khai báo riêng khi đặt sau reverse proxy.
VITE_GATEWAY_HTTP=http://localhost:8081
# Token quản trị được nhập trực tiếp trong tab Cấu hình PLC và chỉ giữ trong RAM
# của tab. Không đặt secret trong biến VITE_* vì chúng được đóng gói ra frontend.
