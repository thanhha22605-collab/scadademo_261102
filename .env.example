# Nguồn dữ liệu cho web app SCADA.
# - sim: chạy bộ mô phỏng trong bộ nhớ (mặc định).
# - plc: đọc tín hiệu thật từ gateway Modbus (xem thư mục gateway/).
# Sao chép file này thành .env rồi chỉnh:
#   cp .env.example .env

VITE_DATA_SOURCE=sim
# Địa chỉ WebSocket của gateway (IP máy chạy gateway trong mạng OT):
VITE_GATEWAY_WS=ws://localhost:8081
